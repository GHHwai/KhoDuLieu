APP_NAME="Healthcare Schema Visualizer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# No database is used: the site only parses resources/sql/schemascript.sql.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Gold data (optional, read-only). Needs the pdo_sqlsrv PHP extension. ---
DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=Healthcare_location
DB_USERNAME=
DB_PASSWORD=
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=true
